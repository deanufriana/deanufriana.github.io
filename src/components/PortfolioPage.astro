---
import DossierSidebar from "@/containers/DossierSidebar.vue";
import Experience from "@/containers/Experience.vue";
import Footer from "@/containers/Footer.vue";
import OverviewPanel from "@/containers/OverviewPanel.vue";
import Projects from "@/containers/Projects.vue";
import resumeEn from "@/data/resume/en.json";
import resumeId from "@/data/resume/id.json";
import BaseLayout from "@/layouts/BaseLayout.astro";
import "../styles/global.css";
import type { ui } from "@/i18n/ui";

interface Props {
  lang?: keyof typeof ui;
}

const { lang = "en" } = Astro.props;

const isId = lang === "id";
const resume = isId ? resumeId : resumeEn;
const title = `${resume.basics.name} | ${resume.basics.label}`;
const description = resume.basics.summary;
const canonicalUrl = isId ? "https://deanufriana.github.io/id/" : "https://deanufriana.github.io/";
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  canonicalUrl={canonicalUrl}
>
  <div class="flex min-h-dvh flex-col lg:flex-row">
    <DossierSidebar
      lang={lang}
      client:load
    />
    <main
      id="main-content"
      class="bg-background flex-1 px-6 py-8 sm:px-8 lg:px-12 lg:py-10"
    >
      <div class="mx-auto max-w-3xl space-y-10">
        <OverviewPanel lang={lang} />
        <Experience
          lang={lang}
          client:visible
        />
        <Projects lang={lang} />
        <Footer lang={lang} />
      </div>
    </main>
  </div>
</BaseLayout>
