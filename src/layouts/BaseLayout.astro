---
import interLatin400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import interLatin700 from "@fontsource/inter/files/inter-latin-700-normal.woff2?url";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  lang?: string;
  canonicalUrl?: string;
  ogImage?: string;
  showHreflang?: boolean;
}

const {
  title,
  description,
  lang = "en",
  canonicalUrl,
  ogImage = "https://deanufriana.github.io/og-image.png",
  showHreflang = false,
} = Astro.props;

const siteUrl = "https://deanufriana.github.io";
const canonical = canonicalUrl || Astro.url.href;

// JSON-LD structured data
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Devi Adi Nufriana",
  url: siteUrl,
  jobTitle: "Software Engineer",
  sameAs: [
    "https://www.linkedin.com/in/deanufriana",
    "https://github.com/deanufriana",
    "https://medium.com/@deanufriana",
  ],
  knowsAbout: ["Vue.js", "React.js", "TypeScript", "JavaScript", "Go", "Flutter"],
};
---

<!doctype html>
<html
  lang={lang}
>
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta
      http-equiv="X-UA-Compatible"
      content="IE=edge"
    />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <link
      rel="preload"
      href={interLatin400}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={interLatin700}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Security & Privacy -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com;"
    />
    <meta
      name="referrer"
      content="strict-origin-when-cross-origin"
    />
    <meta
      name="permissions-policy"
      content="camera=(), microphone=(), geolocation=(), interest-cohort=()"
    />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta
      name="description"
      content={description}
    />
    <meta
      name="author"
      content="Devi Adi Nufriana"
    />
    <link
      rel="canonical"
      href={canonical}
    />
    {
      showHreflang && (
        <>
          <link
            rel="alternate"
            hreflang="en"
            href={`${siteUrl}/`}
          />
          <link
            rel="alternate"
            hreflang="id"
            href={`${siteUrl}/id/`}
          />
          <link
            rel="alternate"
            hreflang="x-default"
            href={`${siteUrl}/`}
          />
        </>
      )
    }

    <!-- Open Graph -->
    <meta
      property="og:title"
      content={title}
    />
    <meta
      property="og:description"
      content={description}
    />
    <meta
      property="og:type"
      content="website"
    />
    <meta
      property="og:url"
      content={canonical}
    />
    <meta
      property="og:image"
      content={ogImage}
    />
    <meta
      property="og:site_name"
      content="Devi Adi Nufriana"
    />
    <meta
      property="og:locale"
      content={lang === "id" ? "id_ID" : "en_US"}
    />

    <!-- Twitter Card -->
    <meta
      name="twitter:card"
      content="summary_large_image"
    />
    <meta
      name="twitter:title"
      content={title}
    />
    <meta
      name="twitter:description"
      content={description}
    />
    <meta
      name="twitter:image"
      content={ogImage}
    />

    <!-- Favicon -->
    <link
      rel="icon"
      type="image/x-icon"
      href="/favicon.ico"
    />

    <!-- Fonts are self-hosted locally via @fontsource/inter in global.css -->

    <!-- JSON-LD Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    ></script>
    <!-- Google Analytics via Partytown (off main thread) -->
    <script
      type="text/partytown"
      src="https://www.googletagmanager.com/gtag/js?id=G-NCLQWHKW9N"
    ></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag(...args) {
        dataLayer.push(args);
      }
      gtag("js", new Date());
      gtag("config", "G-NCLQWHKW9N");
    </script>
    <!-- Prevent FOUC: apply dark/light theme before render, respecting OS preference -->
    <script is:inline>
      function applyTheme() {
        const theme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (theme === "dark" || (!theme && prefersDark)) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      }
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);

      // Smooth language switch transition & scroll position preservation
      if (!window.__langTransitionInitialized) {
        window.__langTransitionInitialized = true;
        let savedScrollY = null;
        let isLangTransition = false;

        document.addEventListener("astro:before-preparation", (event) => {
          const fromPath = event.from?.pathname?.replace(/\/$/, "") || "";
          const toPath = event.to?.pathname?.replace(/\/$/, "") || "";
          const toId = fromPath === "" && toPath === "/id";
          const toEn = fromPath === "/id" && toPath === "";

          if (toId || toEn) {
            savedScrollY = window.scrollY;
            isLangTransition = true;
            document.documentElement.classList.add("lang-transition");
          }
        });

        document.addEventListener("astro:before-swap", (event) => {
          const newRoot = event.newDocument.documentElement;
          newRoot.classList.add("no-intro");

          const theme = localStorage.getItem("theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (theme === "dark" || (!theme && prefersDark)) {
            newRoot.classList.add("dark");
          } else {
            newRoot.classList.remove("dark");
          }

          if (isLangTransition) {
            newRoot.classList.add("lang-transition");
          }
        });

        document.addEventListener("astro:after-swap", () => {
          if (savedScrollY !== null) {
            window.scrollTo({ top: savedScrollY, behavior: "instant" });
            savedScrollY = null;
          }
        });

        document.addEventListener("astro:page-load", () => {
          setTimeout(() => {
            document.documentElement.classList.remove("lang-transition");
            isLangTransition = false;
          }, 360);
        });
      }
    </script>
    <!-- Global Analytics & Interaction Tracking -->
    <script is:inline>
      (() => {
        if (window.__trackingInitialized) return;
        window.__trackingInitialized = true;

        // --- Scroll Milestone Tracking ---
        const milestones = [25, 50, 75, 90];
        const trackedMilestones = new Set();

        document.addEventListener("astro:page-load", () => {
          trackedMilestones.clear();
        });

        window.addEventListener(
          "scroll",
          () => {
            const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
            if (scrollHeight <= 0) return;

            const scrollPercent = Math.round((window.scrollY / scrollHeight) * 100);

            milestones.forEach((m) => {
              if (scrollPercent >= m && !trackedMilestones.has(m)) {
                trackedMilestones.add(m);
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push({
                  event: "scroll",
                  percent_scrolled: m,
                });
              }
            });
          },
          { passive: true },
        );

        // --- Global Click Tracking ---
        document.addEventListener("click", (e) => {
          const target = e.target.closest("button, a");
          if (!target) return;

          const label =
            target.textContent?.trim() ||
            target.getAttribute("aria-label") ||
            target.getAttribute("title") ||
            "unlabeled";
          const type = target.tagName.toLowerCase();
          const isOutbound = target.href && !target.href.includes(window.location.hostname);

          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: "click",
            element_type: type,
            element_text: label,
            element_url: target.href || null,
            element_id: target.id || null,
            outbound: isOutbound,
          });
        });

        // --- Core Web Vitals: Largest Contentful Paint (LCP) ---
        if (
          "PerformanceObserver" in window &&
          PerformanceObserver.supportedEntryTypes?.includes("largest-contentful-paint")
        ) {
          let lastLcpEntry = null;
          let lcpReported = false;

          const lcpObserver = new PerformanceObserver((list) => {
            const entries = list.getEntries();
            if (entries.length > 0) {
              lastLcpEntry = entries[entries.length - 1];
            }
          });

          const reportLcp = () => {
            if (lcpReported || !lastLcpEntry) return;
            lcpReported = true;
            lcpObserver.disconnect();

            const value = Math.round(lastLcpEntry.startTime);
            const rating = value <= 2500 ? "good" : value <= 4000 ? "needs-improvement" : "poor";
            const el = lastLcpEntry.element;
            const element = el ? el.tagName.toLowerCase() + (el.id ? "#" + el.id : "") : "unknown";

            window.__lcpMetric = { value, rating, element };
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({
              event: "web_vitals",
              metric_name: "LCP",
              metric_value: value,
              metric_rating: rating,
              lcp_element: element,
            });
          };

          try {
            lcpObserver.observe({ type: "largest-contentful-paint", buffered: true });

            if (document.readyState === "complete") {
              requestAnimationFrame(reportLcp);
            } else {
              window.addEventListener("load", () => requestAnimationFrame(reportLcp), {
                once: true,
              });
            }

            window.addEventListener("keydown", reportLcp, { once: true, capture: true });
            window.addEventListener("pointerdown", reportLcp, { once: true, capture: true });
            window.addEventListener("pagehide", reportLcp, { once: true });
            document.addEventListener("visibilitychange", () => {
              if (document.visibilityState === "hidden") {
                reportLcp();
              }
            });
          } catch {
            // Ignore unsupported observer options in older browsers
          }
        }
      })();
    </script>
  </head>
  <body class="antialiased">
    <div id="scroll-progress"></div>
    <a
      href="#main-content"
      class="skip-link"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
