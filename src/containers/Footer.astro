---
import { useTranslations, type ui } from "@/i18n/ui";

interface Props {
  lang?: keyof typeof ui;
  name: string;
}

const { lang = "en", name } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="pt-4 pb-2">
  <div class="flex flex-col items-start justify-between gap-2 text-xs sm:flex-row sm:items-center">
    <p class="text-muted-foreground">© {currentYear} {name}</p>
    <p class="text-muted-foreground/70">{t("footer.builtWith")}</p>
  </div>
</footer>
