---
import { buttonVariants } from "@/components/ui/button";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { cn } from "@/lib/utils";
import "../styles/global.css";
---

<BaseLayout
  title="404 - Page Not Found"
  description="The page you're looking for doesn't exist."
>
  <main class="relative flex min-h-screen items-center justify-center overflow-hidden">
    <div class="relative z-10 mx-auto max-w-2xl px-6 text-center">
      <div class="animate-fade-in-up">
        <h1 class="text-foreground font-serif text-8xl font-bold italic md:text-9xl">
          404
        </h1>
        <h2 class="text-foreground mt-4 text-2xl font-bold tracking-tight sm:text-3xl">
          Page Not Found
        </h2>
        <p class="text-muted-foreground mt-6 text-lg leading-relaxed">
          The page you are looking for might have been removed, had its name changed, or is
          temporarily unavailable.
        </p>
        <div class="mt-10 flex justify-center">
          <a
            href="/"
            class={cn(buttonVariants({ variant: "cta", size: "pill" }), "gap-2")}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" />
              <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
            </svg>
            Back to Home
          </a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
